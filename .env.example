# Copy to .env for local development. Do not commit .env.
PPCLASS_ENV=dev
PPCLASS_HTTP_ADDR=:18080
PPCLASS_MYSQL_DSN=ppclassvip:CHANGE_ME@tcp(127.0.0.1:3306)/ppclassvip?charset=utf8mb4&parseTime=True&loc=Local
PPCLASS_JWT_SECRET=replace-with-at-least-32-characters
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=CHANGE_ME
PPCLASS_MYSQL_CONN_MAX_IDLE_TIME=60s
PPCLASS_CLASSROOM_INVITE_TTL=24h
PPCLASS_CLASSROOM_ROOM_TOKEN_TTL=12h
PPCLASS_CLASSROOM_CONSENT_TTL=60s
PPCLASS_CLASSROOM_IDLE_TTL=4h
PPCLASS_LOG_LEVEL=info
PPCLASS_LOG_FORMAT=text
PPCLASS_LOG_FILE=logs/ppclassvip.log

# Local file storage (chat attachments). Recordings are saved in the teacher's browser.
PPCLASS_STORAGE_DATA_DIR=./data

# PPCDN media credentials (leave disabled for offline development).
PPCLASS_PPCDN_ENABLED=false
PPCLASS_PPCDN_BASE_URL=https://api.pp-cdn.org
PPCLASS_PPCDN_APP_ID=
PPCLASS_PPCDN_APP_SECRET=
PPCLASS_PPCDN_KEY_ID=default
PPCLASS_PPCDN_DEVICE_ID=
PPCLASS_PPCDN_REGION=
PPCLASS_PPCDN_TIMEOUT=10s
PPCLASS_PPCDN_MEDIA_TTL=10m
